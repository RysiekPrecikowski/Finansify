node_modules/
.next/
dist/
coverage/
*.tsbuildinfo
.turbo/

# Regenerated by both `next dev` and `next build`, and the two write different
# contents (.next/dev/types vs .next/types), so tracking it leaves the tree
# permanently dirty depending on which ran last.
apps/web/next-env.d.ts

.env
.env.*
!apps/web/.env.example

.DS_Store
*.log

.vercel
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Vendor reference docs installed by `vercel integration add` -- regenerated locally
# whenever that command runs, see README.md setup.
.agents/skills/
skills-lock.json

# `.claude/skills/` holds two unrelated things: symlinks to the vendored docs
# above, and our own project skills. Ignore everything, then re-include only real
# directories -- a trailing slash matches directories and not symlinks, which is
# exactly the split we need. So `.claude/skills/<name>/SKILL.md` is tracked with
# no further edits here, while vendored symlinks stay out.
# (If `vercel integration add` ever installs a real directory instead of a
# symlink, it would be picked up -- check `git status` after running it.)
.claude/skills/*
!.claude/skills/*/
.env*
