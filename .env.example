# Copy to .env.local and fill in. Never commit .env.local.
# Values come from the Supabase dashboard: Project Settings -> API / Database.

# --- Supabase Auth (browser-safe, exposed to the client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database (server only, never expose) ---
# Pooled connection, Supavisor transaction mode, port 6543.
# Used by the app at runtime. Requires prepare:false (see packages/db/src/client.ts).
DATABASE_URL=

# Direct connection, port 5432. Used ONLY by drizzle-kit for migrations,
# because Supavisor transaction mode cannot run multi-statement transactions.
DIRECT_DATABASE_URL=

# --- Market data (Phase 2+) ---
# FX comes from the NBP public API and needs no key.
# Equity/ETF prices need a provider -- still an open decision, see docs/roadmap.md.
MARKET_DATA_API_KEY=
