# Copy to .env.local and fill in. Never commit .env.local.
# All of these are provisioned automatically by `vercel integration add neon` /
# `vercel integration add clerk` and pulled with `vercel env pull .env.local --yes` --
# the names below are exactly what those integrations produce, unrenamed.

# --- Clerk Auth (browser-safe, exposed to the client) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Clerk Auth (server only, never expose) ---
CLERK_SECRET_KEY=

# --- Database (server only, never expose) ---
# Pooled connection (PgBouncer, transaction mode).
# Used by the app at runtime. Requires prepare:false (see packages/db/src/client.ts).
DATABASE_URL=

# Unpooled connection. Used ONLY by drizzle-kit for migrations,
# because the pooler's transaction mode cannot run multi-statement transactions.
DATABASE_URL_UNPOOLED=

# --- Market data (Phase 2+) ---
# FX comes from the NBP public API and needs no key.
# Equity/ETF prices need a provider -- still an open decision, see docs/roadmap.md.
MARKET_DATA_API_KEY=
