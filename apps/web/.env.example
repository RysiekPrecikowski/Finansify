# Neon, via the Vercel Marketplace "Neon-Managed Integration" (ADR 0008).
# Pooled: the app. Unpooled: drizzle-kit migrations only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk, via the Vercel Marketplace Clerk integration (ADR 0009).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Shared test account for local/preview sign-in — sign-up is restricted, so
# this is the only way in. See "Test user" in docs/deployment.md.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Vercel Blob, via the Vercel Marketplace integration — raw uploaded statement
# files (docs/domain.md, "Imports"; the FileStore port keeps Blob swappable).
# Named for the store ("imports"), not the generic default.
BLOB_IMPORTS_READ_WRITE_TOKEN=
BLOB_IMPORTS_STORE_ID=
BLOB_IMPORTS_WEBHOOK_PUBLIC_KEY=
